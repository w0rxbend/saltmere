---
layout: null
permalink: /search.json
sitemap: false
---
{%- assign items = site.articles | sort: "date" | reverse -%}
[
{%- for a in items -%}
{"t":{{ a.title | jsonify }},
"s":{{ a.summary | default: "" | jsonify }},
"g":{{ a.tags | jsonify }},
"k":{{ a.track | jsonify }},
"d":{{ a.date | date: "%Y-%m-%d" | jsonify }},
"r":{{ a.reading_time | default: 0 }},
"u":{{ a.url | relative_url | jsonify }}}
{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
